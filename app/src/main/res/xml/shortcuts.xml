<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="start_session"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutShortLabel="@string/shortcut_start_session_short_label"
        android:shortcutLongLabel="@string/shortcut_start_session_long_label"
        android:shortcutDisabledMessage="@string/shortcut_start_session_disabled">
        <!-- Must match ShortcutHandlerActivity.ACTION_START_MONITORING.
             targetPackage is the applicationId; targetClass follows the namespace, which
             is deliberately still com.cj.tapblok — see app/build.gradle.kts. -->
        <intent
            android:action="com.tj.tapblok.START_MONITORING"
            android:targetPackage="com.tj.tapblok"
            android:targetClass="com.cj.tapblok.ShortcutHandlerActivity" />
    </shortcut>
</shortcuts>

